APP_ENV=production
APP_URL=https://your-domain.example
APP_TIMEZONE=America/Cayenne

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_app_user
DB_PASS=replace-with-a-long-random-secret

# Keep true in production. Set false only for local HTTP development.
SESSION_COOKIE_SECURE=true

Options -Indexes -MultiViews

<IfModule php_module>
    php_value upload_max_filesize 8M
    php_value post_max_size 10M
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com"
</IfModule>

<FilesMatch "(?i)^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(?:sql|log)$">
    Require all denied
</FilesMatch>
